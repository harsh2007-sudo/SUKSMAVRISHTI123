# ---------------------------------------------------------------------------
# Suksmavrishti — farmer login (Phone + OTP) & report delivery credentials
# Copy this file to `.env` and fill in the real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Supabase (farmer registrations: table `farmers`) ---
# Project URL: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key (server-side only — never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Run this once in the Supabase SQL Editor to create the farmers table:
#
# create table if not exists public.farmers (
#     id bigserial primary key,
#     phone text unique not null,
#     name text not null default '',
#     village text not null default '',
#     language text not null default 'English',
#     created_at timestamptz not null default now()
# );
# alter table public.farmers enable row level security;

# --- Twilio (OTP via Verify/SMS + report delivery) ---
# Twilio console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# PREFERRED OTP path: Twilio Verify service (it generates, texts and checks the
# code — no local OTP state). Console -> Verify -> Services -> pick/create one,
# or the "Try out Verify" flow, then copy its SID (VA...).
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Fallback OTP + report channel, used only when the line above is empty:
# SMS when TWILIO_SMS_FROM is set, else WhatsApp (TWILIO_WHATSAPP_FROM).
# A trial account gets its sender from the console (Try out SMS flow) — you do
# not buy it. In production (paid account, India) this must be a DLT-registered
# sender with an approved OTP template.
TWILIO_SMS_FROM=
# WhatsApp sender. Keep EMPTY to guarantee OTP/reports never go to WhatsApp.
TWILIO_WHATSAPP_FROM=
# NOTE 1 (trial): Verify only texts VERIFIED TESTERS. Add each number in the
# console: Try out Verify -> Send a verification -> To (Recipient), then enter
# the code that Twilio texts that phone.
# NOTE 2 (trial): a plain-Messages trial account can only message VERIFIED
# recipients (max 5): Try out SMS Messaging -> add & verify a recipient.

# --- Existing app setting (already in use) ---
WHATSAPP_NUMBER=917303190089

# --- Session / abuse-control settings (optional, defaults shown) ---
# Chief sessions expire after 8 hours and after 45 minutes of inactivity.
SV_CHIEF_SESSION_HOURS=8
SV_CHIEF_IDLE_MINUTES=45
SV_CHIEF_MAX_FAILURES=5
SV_CHIEF_LOCKOUT_MINUTES=15
# Splash screen duration in seconds (was a hard-coded 5s blocking sleep).
SV_SPLASH_SECONDS=1.2
# Farmer sessions also idle out after 60 minutes.
SV_FARMER_IDLE_MINUTES=60

# --- Persistent storage (Render / any host with an ephemeral checkout) ---
# If the app folder is reset on every deploy, point this at a mounted disk so
# chief_credentials.json, logs/security_audit.log and the rate-limit lockout
# state survive redeploys. On Render: attach a Persistent Disk (e.g. at
# /var/data) and set SV_DATA_DIR=/var/data. Unset = keep files in the app folder.
# SV_DATA_DIR=/var/data

# Set to 1 when the app runs behind a reverse proxy you control (nginx, the
# Render edge, deploy/https_proxy.py): rate limits then key on the real client
# IP from X-Forwarded-For instead of the proxy's address.
SV_TRUST_PROXY=1

# NOTE: Chief (Sarpanch) passwords are NOT stored in .env and never in the repo.
# Only PBKDF2 hashes live in chief_credentials.json. Set or rotate them with:
#   python setup_chief_credentials.py --area "Rampur"
#   python setup_chief_credentials.py --list
