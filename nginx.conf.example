# ---------------------------------------------------------------------------
# Suksmavrishti — HTTPS + security headers in front of Streamlit.
#
# Streamlit (Tornado) cannot set custom response headers, so HTTPS, HSTS and
# the CSP must be configured at the reverse proxy / hosting platform. This is
# a TEMPLATE: replace the domain and certificate paths, then `nginx -t` and
# reload. Nothing here is applied automatically.
#
#   streamlit run App.py --server.address 127.0.0.1 --server.port 8501
#
# Notes
# * Streamlit requires inline scripts, so 'unsafe-inline' and 'unsafe-eval'
#   are needed in script-src. Everything else is locked down.
# * frame-ancestors 'none' prevents clickjacking (Streamlit's own components
#   render in same-origin iframes, which this policy still allows).
# ---------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Coarse edge rate limit in addition to the in-app limits (http context).
limit_req_zone $binary_remote_addr zone=sv_app:10m rate=30r/s;

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    # ACME challenge for Let's Encrypt, then redirect everything else to HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.example.com;

    ssl_certificate     /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS: only enable once HTTPS is verified working for this domain.
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;   # legacy fallback for frame-ancestors
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ws: wss:; frame-src 'self'; media-src 'self' blob:" always;

    # Request size cap (photos are 5 MB; Streamlit's own limit matches).
    client_max_body_size 6m;

    limit_req zone=sv_app burst=60 nodelay;

    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Only trust this header because nginx overwrites it.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
